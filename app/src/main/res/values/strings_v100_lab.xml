    <string name="lab100_ctl_right">Right stick</string>
    <string name="lab100_ctl_triggers">Triggers</string>
    <string name="lab100_ctl_drift_start">Measure stick drift</string>
    <string name="lab100_ctl_drift_running">Let go of both sticks for 3 seconds…</string>
    <string name="lab100_ctl_done">Done</string>
    <string name="lab100_drift_ok">rests in the middle (largest reading %1$s)</string>
    <string name="lab100_drift_slight">slight drift of %1$s; fine for most games, raise the emulator’s dead zone if a game creeps</string>
    <string name="lab100_drift_bad">drifts by %1$s; an emulator dead zone hides some of it, and cleaning or replacing the stick may be needed</string>
    <string name="lab100_scr_title">Screen test</string>
    <string name="lab100_scr_hint">Full-screen colours and patterns to spot dead pixels, burn-in and uneven light.</string>
    <string name="lab100_scr_leave">tap or press right for the next, Back to leave</string>
