<!-- 10.0: the Handheld lab -->
<resources>
    <string name="lab100_title">Handheld lab</string>
    <string name="lab100_subtitle">Test your controller, screen and battery</string>
    <string name="lab100_hint">Controller, screen and battery tests</string>
    <string name="lab100_kw">controller test stick drift dead zone dead pixel screen burn-in battery temperature heat gamepad buttons</string>
    <string name="lab100_what">Everything here only looks and measures. Nothing is saved and nothing leaves the device.</string>
    <string name="lab100_ctl_title">Controller test</string>
    <string name="lab100_ctl_hint">Press every button, move both sticks and see what Android receives.</string>
    <string name="lab100_ctl_leave">Back leaves the test. Some handhelds send B as Back; use the Done button then.</string>
    <string name="lab100_ctl_none">Nothing pressed</string>
    <string name="lab100_ctl_pressed">Pressed: %1$s</string>
    <string name="lab100_ctl_seen">Different buttons seen so far: %1$d</string>
