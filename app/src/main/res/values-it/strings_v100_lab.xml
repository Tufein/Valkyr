    <string name="lab100_ctl_hint">Premi ogni pulsante, muovi entrambi gli stick e guarda cosa riceve Android.</string>
    <string name="lab100_ctl_leave">Indietro chiude il test. Alcuni handheld inviano B come Indietro; usa allora il pulsante Fatto.</string>
    <string name="lab100_ctl_none">Niente premuto</string>
